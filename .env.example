# Lấy từ Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Giống hệt 2 giá trị ở trên, chỉ khác là lộ ra browser bundle (prefix
# NEXT_PUBLIC_) — cần cho Realtime Presence (components/admin/PresenceIndicator.tsx)
# kết nối WebSocket trực tiếp từ trình duyệt. An toàn để public vì đã có RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Chỉ dùng cho scripts/seed.ts (chạy local để nạp dữ liệu mẫu), KHÔNG dùng trong app,
# KHÔNG commit giá trị thật. Lấy từ Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Số điện thoại hoặc Zalo OA id dùng cho nút "Nhắn Zalo" (vd: 0901234567)
NEXT_PUBLIC_ZALO_CONTACT=0901234567

# Tuỳ chọn — thông báo Telegram khi có admin đăng nhập / lead mới. Bỏ trống
# thì tính năng này tự tắt (sendTelegramMessage no-op), không lỗi.
# Cách lấy: nhắn @BotFather trên Telegram > /newbot > lấy token.
# Lấy chat id: nhắn thử tin nhắn bất kỳ cho bot, sau đó mở
# https://api.telegram.org/bot<TOKEN>/getUpdates và đọc field "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dùng cho app/sitemap.ts, app/robots.ts (cần URL tuyệt đối)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
