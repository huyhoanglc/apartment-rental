# Lấy từ Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Giống hệt 2 giá trị ở trên, chỉ khác là lộ ra browser bundle (prefix
# NEXT_PUBLIC_) — cần cho Realtime Presence (components/admin/PresenceIndicator.tsx)
# kết nối WebSocket trực tiếp từ trình duyệt. An toàn để public vì đã có RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Chỉ dùng cho scripts/seed.ts (chạy local để nạp dữ liệu mẫu), KHÔNG dùng trong app,
# KHÔNG commit giá trị thật. Lấy từ Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Số điện thoại hoặc Zalo OA id dùng cho nút "Nhắn Zalo" (vd: 0901234567)
NEXT_PUBLIC_ZALO_CONTACT=your-phone

# Tuỳ chọn — thông báo Telegram khi có lead mới / sự kiện bảo mật (đăng nhập,
# MFA, khoá/tạo/xoá tài khoản...). Bỏ trống thì tính năng này tự tắt
# (sendTelegramMessage no-op), không lỗi.
# Cách lấy: nhắn @BotFather trên Telegram > /newbot > lấy token.
# Lấy chat id: nhắn thử tin nhắn bất kỳ cho bot, sau đó mở
# https://api.telegram.org/bot<TOKEN>/getUpdates và đọc field "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
# Group/chat nhận thông báo lead mới (app/api/leads/route.ts).
TELEGRAM_CHAT_ID=
# Tuỳ chọn — group/chat RIÊNG cho cảnh báo bảo mật (lib/admin/security.ts),
# để không lẫn với thông báo lead. Tạo 1 group Telegram mới, add bot vào, lấy
# chat id như hướng dẫn trên. Bỏ trống thì cảnh báo bảo mật tự rơi về chung
# TELEGRAM_CHAT_ID.
TELEGRAM_SECURITY_CHAT_ID=

# Tuỳ chọn — mirror ảnh phòng/dự án sang 1 thư mục Google Drive (Gmail cá nhân,
# không cần Google Workspace) để sale vào xem/tải trực tiếp, song song với ảnh
# chính vẫn lưu Supabase Storage (web luôn hiển thị ảnh từ Supabase). Bỏ trống
# 1 trong 4 biến dưới đây thì tính năng này tự tắt (mirrorImageToDrive no-op),
# không lỗi — xem lib/googleDrive.ts.
#
# Cách lấy:
# 1. Vào https://console.cloud.google.com/ > tạo project mới (hoặc chọn project có sẵn).
# 2. APIs & Services > Library > bật "Google Drive API".
# 3. APIs & Services > OAuth consent screen > chọn "External", điền tên app bất
#    kỳ, ở bước "Test users" thêm đúng địa chỉ Gmail công ty dùng để lưu ảnh
#    (app ở chế độ Testing không cần Google duyệt, nhưng chỉ tài khoản trong
#    danh sách Test users mới đăng nhập được).
# 4. APIs & Services > Credentials > Create Credentials > OAuth client ID >
#    Application type chọn "Desktop app" > tạo xong copy Client ID + Client
#    Secret vào 2 biến bên dưới.
# 5. Vào Google Drive, tạo 1 thư mục gốc (vd "Ảnh phòng cho thuê"), mở thư mục
#    đó, copy đoạn id trong URL (drive.google.com/drive/folders/<ID_NÀY>) vào
#    GOOGLE_DRIVE_ROOT_FOLDER_ID.
# 6. Chạy `npm run drive:auth`, mở link được in ra, đăng nhập đúng tài khoản
#    Gmail công ty ở bước 3, bấm Allow — script tự in dòng
#    GOOGLE_DRIVE_REFRESH_TOKEN=... để copy vào đây.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Dùng cho app/sitemap.ts, app/robots.ts (cần URL tuyệt đối)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bắt buộc nếu bật đăng nhập Google — danh sách email được phép vào /admin,
# phân tách bằng dấu phẩy. Supabase OAuth tự tạo tài khoản mới cho bất kỳ ai
# đăng nhập Google thành công, nên KHÔNG cấu hình biến này = chặn tất cả
# (fail closed). Xem README mục 3 trước khi bật.
ADMIN_ALLOWED_EMAILS=
